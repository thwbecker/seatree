     FC         = mpif90
-    LIB        = ${MACOS_NETCDF_LIB}
-    INC        = ${MACOS_NETCDF_INC}
-    NETCDF_INC = -I${MACOS_NETCDF_INC}
-    NETCDF_LIB = -L${MACOS_NETCDF_LIB} -lnetcdf -L${MACOS_NETCDFF_LIB} -lnetcdff 
+    # Use NETCDFHOME (Fortran) if set, otherwise default to Homebrew prefixes
+    ifeq ($(NETCDFHOME),)
+        NETCDF_FORTRAN_DIR = /opt/homebrew/opt/netcdf-fortran
+        NETCDF_C_DIR       = /opt/homebrew/opt/netcdf
